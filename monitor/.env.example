# Copy to .env.local. Not secrets: where the dashboard finds SpacetimeDB.
# Shared team database: the Headcount module published to Maincloud as "rescuedb" (RescueGrid).
VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIME_DB=rescuedb
# Local server instead (spacetime start):
# VITE_SPACETIME_URI=ws://localhost:3000
# VITE_SPACETIME_DB=headcount

# Vercel server-side draft function only. Never prefix this secret with VITE_.
GEMINI_API_KEY=
# Optional override for the drafting model
GEMINI_MODEL=gemini-2.5-flash
