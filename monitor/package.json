{
  "name": "headcount-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "db:start": "spacetime start",
    "db:status": "node scripts/database.mjs status",
    "db:publish": "node scripts/database.mjs publish",
    "dev:local": "HEADCOUNT_SOURCE=local vite --host",
    "dashboards": "node scripts/dashboards.mjs",
    "dashboards:live": "HEADCOUNT_SOURCE=spacetimedb node scripts/dashboards.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb",
    "promote": "node scripts/promote.mjs",
    "verify:live": "rolldown scripts/verify-live.ts --file node_modules/.cache/verify-live.mjs --format esm --platform node --external vite && node node_modules/.cache/verify-live.mjs",
    "db:status:local": "spacetime sql --server local headcount \"SELECT COUNT(*) AS households FROM household\"",
    "db:publish:local": "spacetime publish --server local --module-path ../spacetimedb --delete-data=never headcount"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-condensed": "^5.2.8",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spacetimedb": "2.14.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
