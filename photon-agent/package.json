{
  "name": "headcount-photon-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@photon-ai/api": "^0.6.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}