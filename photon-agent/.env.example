# Copy to .env. Never commit .env.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=pho_prj_REPLACE_ME
GEMINI_API_KEY=

SPACETIME_URL=http://127.0.0.1:3000
SPACETIME_DB=headcount
# Created by scripts/setup-local.sh
SPACETIME_TOKEN=

ADMIN_PORT=8787

# Voice. Leave blank to run text only.
RETELL_API_KEY=
RETELL_AGENT_ID=
# The Photon number after it is imported into Retell.
VOICE_FROM_NUMBER=
# A teammate playing the dispatcher. The code refuses 911 and other emergency numbers.
DISPATCHER_PHONE=
# Public HTTPS tunnel to VOICE_PORT. Used by scripts/setup-voice.ts.
PUBLIC_URL=
VOICE_PORT=8788
